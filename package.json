{
  "name": "websim-export-tool",
  "version": "0.1.0",
  "description": "Export orchestration tool - Electron Forge, Capacitor, Devvit bridges with a WebSocket-driven UI.",
  "main": "electron-main.js",
  "scripts": {
    "start": "node ws-server.js",
    "start:electron": "electron-forge start",
    "build:electron": "electron-forge make",
    "start:ui": "serve -s . -l 8080",
    "dev": "concurrently \"node ws-server.js\" \"serve -s . -l 8080\""
  },
  "dependencies": {
    "ws": "^8.13.0",
    "express": "^4.18.2",
    "body-parser": "^1.20.2"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-forge": "^6.0.0",
    "@electron-forge/maker-deb": "^6.0.0",
    "@electron-forge/maker-rpm": "^6.0.0",
    "@electron-forge/maker-squirrel": "^6.0.0",
    "concurrently": "^8.2.0",
    "serve": "^14.2.0"
  }
}

